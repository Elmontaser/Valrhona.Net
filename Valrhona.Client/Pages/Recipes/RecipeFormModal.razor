@using Valrhona.Client.Models.Items
@using Valrhona.Client.Models.Lookups
@using Valrhona.Client.Models.Recipes

<div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <EditForm Model="Form" OnValidSubmit="OnValidSubmit">
                <DataAnnotationsValidator />
                <div class="modal-header">
                    <h5 class="modal-title">@(Form.RecipeId == 0 ? "إضافة وصفة" : "تعديل وصفة")</h5>
                    <button type="button" class="btn-close" aria-label="إغلاق" @onclick="OnClose"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(FormError))
                    {
                        <div class="alert alert-danger py-2">@FormError</div>
                    }

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">كود الوصفة</label>
                            <InputText class="form-control" @bind-Value="Form.RecipeCode" />
                            <ValidationMessage For="() => Form.RecipeCode" class="text-danger small" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">اسم الوصفة</label>
                            <InputText class="form-control" @bind-Value="Form.RecipeName" />
                            <ValidationMessage For="() => Form.RecipeName" class="text-danger small" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">صنف الناتج</label>
                            <InputSelect class="form-select" @bind-Value="Form.OutputItemId">
                                <option value="0">اختر الصنف...</option>
                                @foreach (var item in Items)
                                {
                                    <option value="@item.ItemId">@item.ItemCode - @item.ItemName</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => Form.OutputItemId" class="text-danger small" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">كمية الناتج</label>
                            <InputNumber class="form-control" step="any" @bind-Value="Form.OutputQuantity" />
                            <ValidationMessage For="() => Form.OutputQuantity" class="text-danger small" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">وحدة الناتج</label>
                            <InputSelect class="form-select" @bind-Value="Form.OutputUnitId">
                                <option value="0">اختر...</option>
                                @foreach (var unit in Units)
                                {
                                    <option value="@unit.UnitId">@unit.UnitName</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => Form.OutputUnitId" class="text-danger small" />
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">رقم النسخة</label>
                            <InputNumber class="form-control" @bind-Value="Form.VersionNo" />
                            <ValidationMessage For="() => Form.VersionNo" class="text-danger small" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">ملاحظات</label>
                            <InputText class="form-control" @bind-Value="Form.Notes" />
                            <ValidationMessage For="() => Form.Notes" class="text-danger small" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                        <h6 class="fw-bold mb-0">مكونات الوصفة</h6>
                        <button type="button" class="btn btn-sm btn-outline-dark" @onclick="AddIngredient"
                                disabled="@IsSaving">
                            <span class="me-1">＋</span> إضافة مكوّن
                        </button>
                    </div>

                    @if (Form.Ingredients.Count == 0)
                    {
                        <div class="text-muted text-center py-3">أضف مكوّنًا واحدًا على الأقل.</div>
                    }
                    @foreach (var ingredient in Form.Ingredients)
                    {
                        <div class="row g-2 align-items-end mb-3" @key="ingredient">
                            <div class="col-12 col-md-4">
                                <label class="form-label small">المكوّن</label>
                                <InputSelect class="form-select" @bind-Value="ingredient.IngredientItemId">
                                    <option value="0">اختر...</option>
                                    @foreach (var item in Items)
                                    {
                                        <option value="@item.ItemId">@item.ItemCode - @item.ItemName</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-6 col-md-2">
                                <label class="form-label small">الكمية</label>
                                <InputNumber class="form-control" step="any" @bind-Value="ingredient.Quantity" />
                            </div>
                            <div class="col-6 col-md-2">
                                <label class="form-label small">الوحدة</label>
                                <InputSelect class="form-select" @bind-Value="ingredient.UnitId">
                                    <option value="0">اختر...</option>
                                    @foreach (var unit in Units)
                                    {
                                        <option value="@unit.UnitId">@unit.UnitName</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-6 col-md-2">
                                <label class="form-label small">الهدر %</label>
                                <InputNumber class="form-control" step="any" @bind-Value="ingredient.WastePercent" />
                            </div>
                            <div class="col-6 col-md-2">
                                <button type="button" class="btn btn-outline-danger w-100" title="حذف المكوّن"
                                        @onclick="() => RemoveIngredient(ingredient)" disabled="@IsSaving">حذف</button>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="OnClose"
                            disabled="@IsSaving">إلغاء</button>
                    <button type="submit" class="btn btn-dark" disabled="@IsSaving">
                        @if (IsSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        حفظ
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public RecipeFormModel Form { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<ItemDto> Items { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<UnitDto> Units { get; set; } = default!;
    [Parameter] public string? FormError { get; set; }
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public EventCallback OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private void AddIngredient() => Form.Ingredients.Add(new RecipeIngredientFormModel());
    private void RemoveIngredient(RecipeIngredientFormModel ingredient) => Form.Ingredients.Remove(ingredient);
}
