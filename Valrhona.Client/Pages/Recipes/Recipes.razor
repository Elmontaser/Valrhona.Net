@page "/recipes"
@using Valrhona.Client.Models.Items
@using Valrhona.Client.Models.Lookups
@using Valrhona.Client.Models.Recipes
@using Valrhona.Client.Services.Items
@using Valrhona.Client.Services.Lookups
@using Valrhona.Client.Services.Recipes
@inject RecipeService RecipeService
@inject ItemService ItemService
@inject LookupService LookupService

<PageTitle>الوصفات - Valrhona</PageTitle>

<div class="container-fluid">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">الوصفات</h2>
            <p class="text-muted mb-0">إدارة وصفات الإنتاج وكمياتها ومكوناتها</p>
        </div>
        <button type="button" class="btn btn-dark px-4" @onclick="OpenCreate" disabled="@isLoading">
            <span class="me-2">＋</span> إضافة وصفة
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success alert-dismissible shadow-sm">
            @successMessage
            <button type="button" class="btn-close" aria-label="إغلاق" @onclick="() => successMessage = null"></button>
        </div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-6">
                    <label class="form-label fw-semibold">بحث</label>
                    <div class="input-group">
                        <span class="input-group-text">🔍</span>
                        <input type="text" class="form-control" placeholder="ابحث بالكود أو اسم الوصفة أو صنف الناتج..."
                               value="@searchText" @oninput="OnSearchInput" />
                    </div>
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <label class="form-label fw-semibold">الحالة</label>
                    <select class="form-select" value="@selectedStatus" @onchange="OnStatusChanged">
                        <option value="">الكل</option>
                        <option value="true">نشطة</option>
                        <option value="false">غير نشطة</option>
                    </select>
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <button type="button" class="btn btn-outline-secondary w-100" @onclick="ResetFilters">إعادة
                        ضبط</button>
                    </div>
                </div>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5">
                    <div class="spinner-border text-dark" role="status"><span class="visually-hidden">جاري التحميل...</span>
                    </div>
                    <div class="mt-3 text-muted">جاري تحميل الوصفات...</div>
                </div>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger shadow-sm">
                <strong>حدث خطأ أثناء تحميل الوصفات</strong>
                <div class="mt-1">@errorMessage</div>
                <button class="btn btn-sm btn-outline-danger mt-2" @onclick="LoadAllAsync">إعادة المحاولة</button>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="px-4" role="button" @onclick='() => SortBy("id")'># @SortIcon("id")</th>
                                    <th role="button" @onclick='() => SortBy("code")'>كود الوصفة @SortIcon("code")</th>
                                    <th role="button" @onclick='() => SortBy("name")'>اسم الوصفة @SortIcon("name")</th>
                                    <th role="button" @onclick='() => SortBy("output")'>صنف الناتج @SortIcon("output")</th>
                                    <th>كمية الناتج</th>
                                    <th role="button" @onclick='() => SortBy("version")'>النسخة @SortIcon("version")</th>
                                    <th>الحالة</th>
                                    <th class="text-center">الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (pagedRecipes.Count == 0)
                                {
                                    <tr><td colspan="8" class="text-center py-5 text-muted">لا توجد وصفات مطابقة للبحث.</td></tr>
                                }
                                else
                                {
                                    @foreach (var recipe in pagedRecipes)
                                    {
                                        <tr class="@(recipe.IsActive ? "" : "text-muted")">
                                            <td class="px-4">@recipe.RecipeId</td>
                                            <td><span class="fw-semibold">@recipe.RecipeCode</span></td>
                                            <td>@recipe.RecipeName</td>
                                            <td>@GetOutputItemName(recipe)</td>
                                            <td>@recipe.OutputQuantity.ToString("0.####") @GetOutputUnitName(recipe)</td>
                                            <td>@recipe.VersionNo</td>
                                            <td>
                                                @if (recipe.IsActive)
                                                {
                                                    <span class="badge text-bg-success">نشطة</span>
                                                }
                                                else
                                                {
                                                    <span class="badge text-bg-secondary">غير نشطة</span>
                                                }
                                            </td>
                                            <td class="text-center text-nowrap">
                                                <button type="button" class="btn btn-sm btn-outline-primary me-1" title="تعديل"
                                                        @onclick="() => OpenEditAsync(recipe)">✏️</button>
                                                <button type="button" class="btn btn-sm btn-outline-danger" title="إيقاف الوصفة"
                                                        disabled="@(!recipe.IsActive || isSaving)"
                                                        @onclick="() => AskDeactivate(recipe)">⛔</button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-white">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                        <small class="text-muted">عرض @pagedRecipes.Count من @filteredRecipes.Count وصفة (الإجمالي
                            @recipes.Count)</small>
                            <div class="d-flex align-items-center gap-2">
                                <select class="form-select form-select-sm" style="width:auto" value="@pageSize"
                                        @onchange="OnPageSizeChanged">
                                    <option value="10">10</option>
                                    <option value="25">25</option>
                                    <option value="50">50</option>
                                </select>
                                <button class="btn btn-sm btn-outline-secondary" disabled="@(currentPage <= 1)"
                                        @onclick="PreviousPage">السابق</button>
                                <span class="small">@currentPage / @TotalPages</span>
                                <button class="btn btn-sm btn-outline-secondary" disabled="@(currentPage >= TotalPages)"
                                        @onclick="NextPage">التالي</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (showForm)
        {
            <RecipeFormModal Form="form" Items="items" Units="units" FormError="@formError" IsSaving="@isSaving"
                             OnValidSubmit="SaveAsync" OnClose="CloseForm" />
        }

        @if (recipeToDeactivate is not null)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
                <div class="modal-dialog modal-dialog-centered modal-sm">
                    <div class="modal-content">
                        <div class="modal-body text-center py-4">
                            <div class="fs-1">⚠️</div>
                            <p class="mt-2 mb-1">هل تريد إيقاف هذه الوصفة؟</p>
                            <strong>@recipeToDeactivate.RecipeName</strong>
                            @if (!string.IsNullOrWhiteSpace(deactivateError))
                            {
                                <div class="alert alert-danger py-2 mt-3 mb-0 small">@deactivateError</div>
                            }
                        </div>
                        <div class="modal-footer justify-content-center">
                            <button class="btn btn-outline-secondary" @onclick="CancelDeactivate"
                                    disabled="@isSaving">إلغاء</button>
                            <button class="btn btn-danger" @onclick="ConfirmDeactivateAsync" disabled="@isSaving">إيقاف</button>
                        </div>
                    </div>
                </div>
            </div>
        }

@code {
    private List<RecipeDto> recipes = new();
    private List<ItemDto> items = new();
    private List<UnitDto> units = new();
    private List<RecipeDto> filteredRecipes = new();
    private List<RecipeDto> pagedRecipes = new();
    private bool isLoading = true;
    private bool isSaving;
    private bool showForm;
    private string? errorMessage;
    private string? successMessage;
    private string? formError;
    private string? deactivateError;
    private string searchText = string.Empty;
    private string selectedStatus = string.Empty;
    private string sortColumn = "id";
    private bool sortDescending;
    private int currentPage = 1;
    private int pageSize = 10;
    private RecipeFormModel form = new();
    private RecipeDto? recipeToDeactivate;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(filteredRecipes.Count / (double)pageSize));

    protected override async Task OnInitializedAsync() => await LoadAllAsync();

    private async Task LoadAllAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            var recipesTask = RecipeService.GetAllAsync();
            var itemsTask = ItemService.GetAllAsync();
            var unitsTask = LookupService.GetUnitsAsync();
            await Task.WhenAll(recipesTask, itemsTask, unitsTask);
            recipes = recipesTask.Result;
            items = itemsTask.Result;
            units = unitsTask.Result;
            Refresh();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Refresh()
    {
        IEnumerable<RecipeDto> result = recipes;
        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var search = searchText.Trim();
            result = result.Where(recipe =>
                recipe.RecipeCode.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                recipe.RecipeName.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                GetOutputItemName(recipe).Contains(search, StringComparison.OrdinalIgnoreCase));
        }
        if (bool.TryParse(selectedStatus, out var active))
            result = result.Where(recipe => recipe.IsActive == active);

        result = (sortColumn, sortDescending) switch
        {
            ("code", false) => result.OrderBy(recipe => recipe.RecipeCode),
            ("code", true) => result.OrderByDescending(recipe => recipe.RecipeCode),
            ("name", false) => result.OrderBy(recipe => recipe.RecipeName),
            ("name", true) => result.OrderByDescending(recipe => recipe.RecipeName),
            ("output", false) => result.OrderBy(recipe => GetOutputItemName(recipe)),
            ("output", true) => result.OrderByDescending(recipe => GetOutputItemName(recipe)),
            ("version", false) => result.OrderBy(recipe => recipe.VersionNo),
            ("version", true) => result.OrderByDescending(recipe => recipe.VersionNo),
            ("id", true) => result.OrderByDescending(recipe => recipe.RecipeId),
            _ => result.OrderBy(recipe => recipe.RecipeId)
        };
        filteredRecipes = result.ToList();
        if (currentPage > TotalPages)
            currentPage = TotalPages;
        UpdatePage();
    }

    private void UpdatePage() => pagedRecipes = filteredRecipes.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? string.Empty;
        currentPage = 1;
        Refresh();
    }

    private void OnStatusChanged(ChangeEventArgs e)
    {
        selectedStatus = e.Value?.ToString() ?? string.Empty;
        currentPage = 1;
        Refresh();
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size))
            pageSize = size;
        currentPage = 1;
        Refresh();
    }

    private void ResetFilters()
    {
        searchText = selectedStatus = string.Empty;
        currentPage = 1;
        Refresh();
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
            sortDescending = !sortDescending;
        else
        {
            sortColumn = column;
            sortDescending = false;
        }
        Refresh();
    }

    private string SortIcon(string column) => sortColumn != column ? "" : sortDescending ? "▼" : "▲";
    private void PreviousPage() { if (currentPage > 1) { currentPage--; UpdatePage(); } }
    private void NextPage() { if (currentPage < TotalPages) { currentPage++; UpdatePage(); } }

    private void OpenCreate()
    {
        form = new RecipeFormModel { VersionNo = 1, Ingredients = { new RecipeIngredientFormModel() } };
        formError = null;
        showForm = true;
    }

    private async Task OpenEditAsync(RecipeDto recipe)
    {
        try
        {
            isSaving = true;
            formError = null;
            var details = await RecipeService.GetIngredientsAsync(recipe.RecipeId);
            form = new RecipeFormModel
            {
                RecipeId = recipe.RecipeId,
                RecipeCode = recipe.RecipeCode,
                RecipeName = recipe.RecipeName,
                OutputItemId = recipe.OutputItemId,
                OutputQuantity = recipe.OutputQuantity,
                OutputUnitId = recipe.OutputUnitId,
                VersionNo = recipe.VersionNo,
                Notes = recipe.Notes,
                Ingredients = details.Select(detail => new RecipeIngredientFormModel
                {
                    IngredientItemId = detail.IngredientItemId,
                    Quantity = detail.Quantity,
                    UnitId = detail.UnitId,
                    WastePercent = detail.WastePercent,
                    Notes = detail.Notes
                }).ToList()
            };
            if (form.Ingredients.Count == 0)
                form.Ingredients.Add(new RecipeIngredientFormModel());
            showForm = true;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void CloseForm() => showForm = false;

    private async Task SaveAsync()
    {
        if (form.Ingredients.Count == 0 || form.Ingredients.Any(ingredient =>
                ingredient.IngredientItemId <= 0 || ingredient.Quantity <= 0 || ingredient.UnitId <= 0 ||
                ingredient.WastePercent < 0 || ingredient.WastePercent > 100))
        {
            formError = "أكمل بيانات كل مكوّن، وتأكد أن الكمية موجبة ونسبة الهدر بين 0 و100.";
            return;
        }
        try
        {
            isSaving = true;
            formError = null;
            var isNew = form.RecipeId == 0;
            if (isNew)
                await RecipeService.CreateAsync(form);
            else
                await RecipeService.UpdateAsync(form);
            recipes = await RecipeService.GetAllAsync();
            Refresh();
            showForm = false;
            successMessage = isNew ? "تمت إضافة الوصفة بنجاح." : "تم تعديل الوصفة بنجاح.";
        }
        catch (Exception ex)
        {
            formError = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void AskDeactivate(RecipeDto recipe)
    {
        recipeToDeactivate = recipe;
        deactivateError = null;
    }

    private void CancelDeactivate() => recipeToDeactivate = null;

    private async Task ConfirmDeactivateAsync()
    {
        if (recipeToDeactivate is null)
            return;
        try
        {
            isSaving = true;
            deactivateError = null;
            await RecipeService.DeactivateAsync(recipeToDeactivate.RecipeId);
            recipeToDeactivate = null;
            recipes = await RecipeService.GetAllAsync();
            Refresh();
            successMessage = "تم إيقاف الوصفة.";
        }
        catch (Exception ex)
        {
            deactivateError = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private string GetOutputItemName(RecipeDto recipe) =>
        recipe.OutputItemName ?? items.FirstOrDefault(item => item.ItemId == recipe.OutputItemId)?.ItemName ?? $"صنف {recipe.OutputItemId}";

    private string GetOutputUnitName(RecipeDto recipe) =>
        recipe.OutputUnitSymbol ?? recipe.OutputUnitName ?? units.FirstOrDefault(unit => unit.UnitId ==
recipe.OutputUnitId)?.Symbol
        ?? units.FirstOrDefault(unit => unit.UnitId == recipe.OutputUnitId)?.UnitName ?? string.Empty;
}
