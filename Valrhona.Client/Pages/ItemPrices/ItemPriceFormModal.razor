@using Valrhona.Client.Models.Items
@using Valrhona.Client.Models.ItemPrices
@using Valrhona.Client.Models.Lookups

<div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <EditForm Model="Form" OnValidSubmit="OnValidSubmit">
                <DataAnnotationsValidator />
                <div class="modal-header">
                    <h5 class="modal-title">تسجيل سعر صنف</h5>
                    <button type="button" class="btn-close" aria-label="إغلاق" @onclick="OnClose"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(FormError))
                    {
                        <div class="alert alert-danger py-2">@FormError</div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold">الصنف</label>
                        <InputSelect class="form-select" @bind-Value="Form.ItemId" @bind-Value:after="OnItemChanged">
                            <option value="0">اختر الصنف...</option>
                            @foreach (var item in Items.Where(item => item.IsActive))
                            {
                                <option value="@item.ItemId">@item.ItemCode - @item.ItemName</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => Form.ItemId" class="text-danger small" />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-7">
                            <label class="form-label fw-semibold">السعر</label>
                            <InputNumber class="form-control" @bind-Value="Form.Price" min="0" step="0.0001" />
                            <ValidationMessage For="() => Form.Price" class="text-danger small" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-semibold">العملة</label>
                            <InputText class="form-control" @bind-Value="Form.Currency" />
                            <ValidationMessage For="() => Form.Currency" class="text-danger small" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">وحدة السعر</label>
                            <InputSelect class="form-select" @bind-Value="Form.UnitId">
                                <option value="0">اختر الوحدة...</option>
                                @foreach (var unit in Units.Where(unit => unit.IsActive))
                                {
                                    <option value="@unit.UnitId">@UnitLabel(unit)</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => Form.UnitId" class="text-danger small" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">تاريخ السريان</label>
                            <InputDate class="form-control" @bind-Value="Form.EffectiveDate" />
                        </div>
                    </div>

                    <div>
                        <label class="form-label fw-semibold">ملاحظات</label>
                        <InputTextArea class="form-control" rows="2" @bind-Value="Form.Notes" />
                        <ValidationMessage For="() => Form.Notes" class="text-danger small" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="OnClose"
                            disabled="@IsSaving">إلغاء</button>
                    <button type="submit" class="btn btn-dark" disabled="@IsSaving">
                        @(IsSaving ? "جارٍ الحفظ..." : "حفظ السعر")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ItemPriceFormModel Form { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<ItemDto> Items { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<UnitDto> Units { get; set; } = default!;
    [Parameter] public string? FormError { get; set; }
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public EventCallback OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private void OnItemChanged()
    {
        var selectedItem = Items.FirstOrDefault(item => item.ItemId == Form.ItemId);
        if (selectedItem is not null && Units.Any(unit => unit.UnitId == selectedItem.UnitId && unit.IsActive))
            Form.UnitId = selectedItem.UnitId;
    }

    private static string UnitLabel(UnitDto unit) =>
        string.IsNullOrWhiteSpace(unit.Symbol)
            ? unit.UnitName
            : $"{unit.UnitName} ({unit.Symbol})";
}