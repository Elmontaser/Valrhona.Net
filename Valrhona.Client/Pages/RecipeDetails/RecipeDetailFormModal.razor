@using Valrhona.Client.Models.Items
@using Valrhona.Client.Models.Lookups
@using Valrhona.Client.Models.Recipes

<div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <EditForm Model="Form" OnValidSubmit="OnValidSubmit">
                <DataAnnotationsValidator />
                <div class="modal-header">
                    <h5 class="modal-title">@(Form.RecipeDetailId == 0 ? "إضافة مكوّن" : "تعديل مكوّن")</h5>
                    <button type="button" class="btn-close" aria-label="إغلاق" @onclick="OnClose"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(FormError))
                    {
                        <div class="alert alert-danger py-2">@FormError</div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold">المكوّن</label>
                        <InputSelect class="form-select" @bind-Value="Form.IngredientItemId">
                            <option value="0">اختر المكوّن...</option>
                            @foreach (var item in Items.Where(item => item.IsActive))
                            {
                                <option value="@item.ItemId">@item.ItemCode - @item.ItemName</option>
                            }
                            @if (Form.IngredientItemId > 0 && !Items.Any(item => item.ItemId == Form.IngredientItemId && item.IsActive))
                            {
                                <option value="@Form.IngredientItemId">@Form.CurrentItemLabel (غير نشط)</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => Form.IngredientItemId" class="text-danger small" />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">الكمية</label>
                            <InputNumber class="form-control" step="any" @bind-Value="Form.Quantity" />
                            <ValidationMessage For="() => Form.Quantity" class="text-danger small" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">الوحدة</label>
                            <InputSelect class="form-select" @bind-Value="Form.UnitId">
                                <option value="0">اختر الوحدة...</option>
                                @foreach (var unit in Units.Where(unit => unit.IsActive))
                                {
                                    <option value="@unit.UnitId">@UnitLabel(unit)</option>
                                }
                                @if (Form.UnitId > 0 && !Units.Any(unit => unit.UnitId == Form.UnitId))
                                {
                                    <option value="@Form.UnitId">@Form.CurrentUnitLabel (غير نشطة)</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => Form.UnitId" class="text-danger small" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">نسبة الهدر %</label>
                        <InputNumber class="form-control" step="0.01" @bind-Value="Form.WastePercent" />
                        <ValidationMessage For="() => Form.WastePercent" class="text-danger small" />
                    </div>

                    <div>
                        <label class="form-label fw-semibold">ملاحظات</label>
                        <InputTextArea class="form-control" rows="2" @bind-Value="Form.Notes" />
                        <ValidationMessage For="() => Form.Notes" class="text-danger small" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="OnClose"
                            disabled="@IsSaving">إلغاء</button>
                    <button type="submit" class="btn btn-dark" disabled="@IsSaving">
                        @(IsSaving ? "جارٍ الحفظ..." : "حفظ المكوّن")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public RecipeDetailFormModel Form { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<ItemDto> Items { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<UnitDto> Units { get; set; } = default!;
    [Parameter] public string? FormError { get; set; }
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public EventCallback OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private static string UnitLabel(UnitDto unit) =>
        string.IsNullOrWhiteSpace(unit.Symbol) ? unit.UnitName : $"{unit.UnitName} ({unit.Symbol})";
}