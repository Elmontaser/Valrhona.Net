@page "/unit-conversions"
@using Valrhona.Client.Models.Lookups
@using Valrhona.Client.Models.UnitConversions
@using Valrhona.Client.Services.Lookups
@using Valrhona.Client.Services.UnitConversions
@inject UnitConversionService UnitConversionService
@inject LookupService LookupService

<PageTitle>تحويل الوحدات - Valrhona</PageTitle>

<div class="container-fluid">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">تحويل الوحدات</h2>
            <p class="text-muted mb-0">إدارة معاملات التحويل بين وحدات القياس</p>
        </div>
        <button type="button" class="btn btn-dark px-4" @onclick="OpenCreate" disabled="@isLoading">
            <span class="me-2">＋</span> إضافة تحويل
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success alert-dismissible shadow-sm">
            @successMessage
            <button type="button" class="btn-close" aria-label="إغلاق" @onclick="() => successMessage = null"></button>
        </div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-6">
                    <label class="form-label fw-semibold">بحث</label>
                    <div class="input-group">
                        <span class="input-group-text">🔍</span>
                        <input type="text" class="form-control" placeholder="ابحث باسم الوحدة أو الملاحظات..."
                               value="@searchText" @oninput="OnSearchInput" />
                    </div>
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <label class="form-label fw-semibold">الحالة</label>
                    <select class="form-select" value="@selectedStatus" @onchange="OnStatusChanged">
                        <option value="">الكل</option>
                        <option value="true">نشط</option>
                        <option value="false">غير نشط</option>
                    </select>
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <button type="button" class="btn btn-outline-secondary w-100" @onclick="ResetFilters">
                        إعادة ضبط
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <div class="spinner-border text-dark" role="status">
                    <span class="visually-hidden">جاري التحميل...</span>
                </div>
                <div class="mt-3 text-muted">جاري تحميل التحويلات...</div>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(loadError))
    {
        <div class="alert alert-danger shadow-sm">
            <strong>حدث خطأ أثناء تحميل التحويلات</strong>
            <div class="mt-1">@loadError</div>
            <button type="button" class="btn btn-sm btn-outline-danger mt-2" @onclick="LoadAllAsync">
                إعادة المحاولة
            </button>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="px-4">#</th>
                                <th>من وحدة</th>
                                <th>إلى وحدة</th>
                                <th>معامل التحويل</th>
                                <th>الحالة</th>
                                <th>ملاحظات</th>
                                <th class="text-center">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (pagedConversions.Count == 0)
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        لا توجد تحويلات مطابقة للبحث.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var conversion in pagedConversions)
                                {
                                    <tr class="@(conversion.IsActive ? "" : "text-muted")">
                                        <td class="px-4">@conversion.UnitConversionId</td>
                                        <td>@FormatUnit(conversion.FromUnitName, conversion.FromUnitSymbol)</td>
                                        <td>@FormatUnit(conversion.ToUnitName, conversion.ToUnitSymbol)</td>
                                        <td class="fw-semibold">@conversion.ConversionFactor.ToString("0.########")</td>
                                        <td>
                                            @if (conversion.IsActive)
                                            {
                                                <span class="badge text-bg-success">نشط</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-secondary">غير نشط</span>
                                            }
                                        </td>
                                        <td>@(string.IsNullOrWhiteSpace(conversion.Notes) ? "—" : conversion.Notes)</td>
                                        <td class="text-center text-nowrap">
                                            <button type="button" class="btn btn-sm btn-outline-primary me-1" title="تعديل"
                                                    disabled="@isSaving" @onclick="() => OpenEdit(conversion)">✏️</button>
                                            <button type="button"
                                                    class="btn btn-sm @(conversion.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                                    title="@(conversion.IsActive ? "إيقاف التحويل" : "تفعيل التحويل")"
                                                    aria-label="@(conversion.IsActive ? "إيقاف التحويل" : "تفعيل التحويل")"
                                                    disabled="@isSaving"
                                                    @onclick="() => AskToggleStatus(conversion)">@(conversion.IsActive ? "⛔" : "▶")</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-white">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                    <small class="text-muted">
                        عرض @pagedConversions.Count من @filteredConversions.Count قاعدة (الإجمالي @conversions.Count)
                    </small>
                    <div class="d-flex align-items-center gap-2">
                        <select class="form-select form-select-sm" style="width:auto" value="@pageSize"
                                @onchange="OnPageSizeChanged">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(currentPage <= 1)"
                                @onclick="PreviousPage">السابق</button>
                        <span class="small">@currentPage / @TotalPages</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(currentPage >= TotalPages)"
                                @onclick="NextPage">التالي</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (showForm)
{
    <UnitConversionFormModal Form="@form" Units="@units" FormError="@formError"
                             IsSaving="@isSaving" OnValidSubmit="SaveAsync" OnClose="CloseForm" />
}

@if (conversionPendingStatusChange is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-body text-center py-4">
                    <div class="fs-1">@(pendingIsActive ? "▶" : "⚠️")</div>
                    <p class="mt-2 mb-1">هل تريد @(pendingIsActive ? "تفعيل" : "إيقاف") قاعدة التحويل؟</p>
                    <strong>@FormatUnit(conversionPendingStatusChange.FromUnitName, conversionPendingStatusChange.FromUnitSymbol)</strong>
                    <span class="mx-1">←</span>
                    <strong>@FormatUnit(conversionPendingStatusChange.ToUnitName, conversionPendingStatusChange.ToUnitSymbol)</strong>
                    @if (!string.IsNullOrWhiteSpace(statusChangeError))
                    {
                        <div class="alert alert-danger py-2 mt-3 mb-0 small">@statusChangeError</div>
                    }
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelStatusChange"
                            disabled="@isSaving">إلغاء</button>
                    <button type="button" class="btn @(pendingIsActive ? "btn-success" : "btn-danger")"
                            @onclick="ConfirmStatusChangeAsync" disabled="@isSaving">
                        @(isSaving ? "جارٍ الحفظ..." : pendingIsActive ? "تفعيل" : "إيقاف")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<UnitConversionDto> conversions = new();
    private List<UnitDto> units = new();
    private List<UnitConversionDto> filteredConversions = new();
    private List<UnitConversionDto> pagedConversions = new();

    private bool isLoading = true;
    private bool isSaving;
    private string? loadError;
    private string? successMessage;
    private string? searchText;
    private string selectedStatus = string.Empty;
    private int currentPage = 1;
    private int pageSize = 10;

    private bool showForm;
    private UnitConversionFormModel form = new();
    private string? formError;
    private UnitConversionDto? conversionPendingStatusChange;
    private bool pendingIsActive;
    private string? statusChangeError;

    private int TotalPages =>
        Math.Max(1, (int)Math.Ceiling(filteredConversions.Count / (double)pageSize));

    protected override async Task OnInitializedAsync() => await LoadAllAsync();

    private async Task LoadAllAsync()
    {
        try
        {
            isLoading = true;
            loadError = null;

            var conversionsTask = UnitConversionService.GetAllAsync();
            var unitsTask = LookupService.GetUnitsAsync();
            await Task.WhenAll(conversionsTask, unitsTask);

            conversions = conversionsTask.Result;
            units = unitsTask.Result;
            Refresh();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Refresh()
    {
        IEnumerable<UnitConversionDto> result = conversions;

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var term = searchText.Trim();
            result = result.Where(conversion =>
                conversion.FromUnitName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                conversion.ToUnitName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (conversion.FromUnitSymbol?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (conversion.ToUnitSymbol?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (conversion.Notes?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        if (bool.TryParse(selectedStatus, out var isActive))
            result = result.Where(conversion => conversion.IsActive == isActive);

        filteredConversions = result
            .OrderBy(conversion => conversion.FromUnitName)
            .ThenBy(conversion => conversion.ToUnitName)
            .ToList();

        if (currentPage > TotalPages)
            currentPage = TotalPages;

        UpdatePage();
    }

    private void UpdatePage()
    {
        pagedConversions = filteredConversions
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private void OnSearchInput(ChangeEventArgs args)
    {
        searchText = args.Value?.ToString();
        currentPage = 1;
        Refresh();
    }

    private void OnStatusChanged(ChangeEventArgs args)
    {
        selectedStatus = args.Value?.ToString() ?? string.Empty;
        currentPage = 1;
        Refresh();
    }

    private void ResetFilters()
    {
        searchText = null;
        selectedStatus = string.Empty;
        currentPage = 1;
        Refresh();
    }

    private void OnPageSizeChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var size))
            pageSize = size;

        currentPage = 1;
        Refresh();
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            UpdatePage();
        }
    }

    private void NextPage()
    {
        if (currentPage < TotalPages)
        {
            currentPage++;
            UpdatePage();
        }
    }

    private void OpenCreate()
    {
        form = new UnitConversionFormModel();
        formError = null;
        showForm = true;
    }

    private void OpenEdit(UnitConversionDto conversion)
    {
        form = new UnitConversionFormModel
        {
            UnitConversionId = conversion.UnitConversionId,
            FromUnitId = conversion.FromUnitId,
            FromUnitName = conversion.FromUnitName,
            ToUnitId = conversion.ToUnitId,
            ToUnitName = conversion.ToUnitName,
            ConversionFactor = conversion.ConversionFactor,
            Notes = conversion.Notes
        };
        formError = null;
        showForm = true;
    }

    private void CloseForm() => showForm = false;

    private async Task SaveAsync()
    {
        try
        {
            isSaving = true;
            formError = null;
            successMessage = null;
            var isNew = form.UnitConversionId == 0;

            if (isNew)
                await UnitConversionService.CreateAsync(form);
            else
                await UnitConversionService.UpdateAsync(form);

            conversions = await UnitConversionService.GetAllAsync();
            Refresh();
            showForm = false;
            successMessage = isNew
                ? "تمت إضافة قاعدة التحويل بنجاح."
                : "تم تعديل قاعدة التحويل بنجاح.";
        }
        catch (Exception ex)
        {
            formError = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void AskToggleStatus(UnitConversionDto conversion)
    {
        conversionPendingStatusChange = conversion;
        pendingIsActive = !conversion.IsActive;
        statusChangeError = null;
    }

    private void CancelStatusChange() => conversionPendingStatusChange = null;

    private async Task ConfirmStatusChangeAsync()
    {
        if (conversionPendingStatusChange is null)
            return;

        try
        {
            isSaving = true;
            statusChangeError = null;
            successMessage = null;
            await UnitConversionService.SetActiveAsync(
                conversionPendingStatusChange.UnitConversionId,
                pendingIsActive);

            conversions = await UnitConversionService.GetAllAsync();
            Refresh();
            successMessage = pendingIsActive
                ? "تم تفعيل قاعدة التحويل."
                : "تم إيقاف قاعدة التحويل.";
            conversionPendingStatusChange = null;
        }
        catch (Exception ex)
        {
            statusChangeError = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private static string FormatUnit(string name, string? symbol) =>
        string.IsNullOrWhiteSpace(symbol) ? name : $"{name} ({symbol})";
}