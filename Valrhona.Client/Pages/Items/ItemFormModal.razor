@using Valrhona.Client.Models.Items
@using Valrhona.Client.Models.Lookups

<div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <EditForm Model="Form" OnValidSubmit="OnValidSubmit">
                <DataAnnotationsValidator />

                <div class="modal-header">
                    <h5 class="modal-title">@(Form.ItemId == 0 ? "إضافة صنف" : "تعديل صنف")</h5>
                    <button type="button" class="btn-close" aria-label="إغلاق" @onclick="OnClose"></button>
                </div>

                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(FormError))
                    {
                        <div class="alert alert-danger py-2">@FormError</div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold">كود الصنف</label>
                        <InputText class="form-control" @bind-Value="Form.ItemCode" />
                        <ValidationMessage For="() => Form.ItemCode" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">اسم الصنف</label>
                        <InputText class="form-control" @bind-Value="Form.ItemName" />
                        <ValidationMessage For="() => Form.ItemName" class="text-danger small" />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">النوع</label>
                            <InputSelect class="form-select" @bind-Value="Form.ItemTypeId">
                                <option value="0">اختر...</option>
                                @foreach (var type in ItemTypes.Where(itemType => itemType.IsActive))
                                {
                                    <option value="@type.ItemTypeId">@type.TypeName</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => Form.ItemTypeId" class="text-danger small" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">الوحدة</label>
                            <InputSelect class="form-select" @bind-Value="Form.UnitId">
                                <option value="0">اختر...</option>
                                @foreach (var unit in Units.Where(unit => unit.IsActive))
                                {
                                    <option value="@unit.UnitId">@unit.UnitName</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => Form.UnitId" class="text-danger small" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">الفئة</label>
                        <InputSelect class="form-select" @bind-Value="Form.CategoryId">
                            <option value="0">اختر...</option>
                            @foreach (var category in Categories.Where(category => category.IsActive ||
                            category.CategoryId == Form.CategoryId))
                            {
                                <option value="@category.CategoryId">@category.CategoryName@(category.IsActive ? "" : " (غير فعالة)")</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => Form.CategoryId" class="text-danger small" />
                    </div>

                    <div class="mb-0">
                        <label class="form-label fw-semibold">ملاحظات</label>
                        <InputTextArea class="form-control" rows="2" @bind-Value="Form.Notes" />
                        <ValidationMessage For="() => Form.Notes" class="text-danger small" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="OnClose"
                            disabled="@IsSaving">إلغاء</button>
                    <button type="submit" class="btn btn-dark" disabled="@IsSaving">
                        @if (IsSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        حفظ
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ItemFormModel Form { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<ItemTypeDto> ItemTypes { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<UnitDto> Units { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<CategoryDto> Categories { get; set; } = default!;
    [Parameter] public string? FormError { get; set; }
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public EventCallback OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
}
